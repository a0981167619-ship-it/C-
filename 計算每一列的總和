#include <iostream>
using namespace std;
int main()
{
	int a[3][4]={
		        {10,20,30,40},
		        {5,15,25,35},
				{2,4,6,8}
				};
	int i,sum=0,j,sum2=0,sum3=0;
	for(i=0;i<1;i++)
	{
		for(j=0;j<4;j++)
		{
			sum+=a[i][j];
			sum2+=a[1][j];
			sum3+=a[2][j];
			
		}
	}
	cout<<"第一列的總和為:"<<sum<<endl;
	cout<<"第二列的總和為:"<<sum2<<'\n';
	cout<<"第三列的總和為:"<<sum3<<endl;
	return 0;
				
	
}
