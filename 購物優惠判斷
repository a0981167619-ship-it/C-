#include <iostream>
using namespace std;
int main()
{
	
	//規定: 1.消費滿1000元可以獲得會員優惠   2.消費金額低於500元屬於低消費金額 
	       
	 
	int total=1250;
	
	bool discount;  
	discount=total>1000;
	cout<<"是否符合會員優惠:"<<discount<<endl;  //輸出1為符合,輸出0為不符合 
	
	bool same;
	same=total==1500;
	cout<<"是否剛好花費1500元:"<<same<<'\n';
	
	bool low;
	low=total<500;
	cout<<"是否屬於低消費金額:"<<low;
	
	return 0;
}
