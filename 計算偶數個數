#include <iostream>
using namespace std;
int main()
{
	int y[6]; //宣告一個可以存放6個整數的一維陣列
	int i;
	int count=0;
	for (i=0;i<6;i++) 
	{
		cout<<"請輸入一個整數:"<<endl;
	    cin>>y[i];
		
	}
	    
	for(i=0;i<6;i++)
	{
		if(y[i]%2==0)//判斷陣列裡面的數字是不是偶數 
		  count++;
	}
	cout<<"偶數數量有:"<<count<<"個"<<endl;
	return 0; 
}
