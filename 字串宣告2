#include <iostream>
using namespace std;
int main()
{
	char word[20]="program";
	cout<<"字串為:"<<word<<endl;
	int i=0;
	
	for (i=0;i<20;i++)
	    {
	    	if(word[i]=='\0') //若不為字串結束符號,i值遞增 
	    	   {
	    	   	 break; //終止迴圈 
			   }
		}
	cout<<"\0所在的位置為:"<<i<<endl;
	
	
	char b[100]="computer";
	cout<<"字串為:"<<b<<'\n';
	
	int a=0;
	while(b[a]!='\0')
	      {
	      	a++;
		  }
		  
   cout<<"\0所在的位置為:"<<a;
	return 0;
}
