#include <iostream>
using namespace std;
int main()
{
	int x[4][3]={
		        {8,12,5},
		        {10,7,13},
		        {6,15,9},
		        {20,4,11}
				};
				
	int i,j,sum1=0,sum2=0,sum3=0,sum4=0;
	for(i=0;i<1;i++)
	{
		for(j=0;j<3;j++)
		{
			sum1+=x[i][j]; //計算二維陣列的第一列總和 
			sum2+=x[i+1][j];
			sum3+=x[i+2][j];
			sum4+=x[i+3][j];
		}
	}
	cout<<"二維陣列的第一列總和:"<<sum1<<endl;
	cout<<"二維陣列的第二列總和:"<<sum2<<'\n';
	cout<<"二維陣列的第三列總和:"<<sum3<<endl;
	cout<<"二維陣列的第四列總和:"<<sum4<<'\n';
	return 0;
				
	
