#include <iostream>
using namespace std;
int main()

{
	// 0:空房  1:有病人  2:清潔中 
	int room[2][2][3]={
		              {
		                {1,0,2},
		                {0,1,1}
					  },
					  
					  {
					  	{2,1,0},
					  	{1,0,2}
					  }, 
					  };
	int x,y,z,a,b,sum=0;
	for(x=0;x<2;x++)
	{
		for(y=0;y<2;y++)
		{
			for(z=0;z<3;z++)
			{
				if(room[x][y][z]==0)
				{
					a++;
					
				}
				else if(room[x][y][z]==1)
				{
					b++;
				}
				else 
				    sum++;
				
			}
		}
	}
	cout<<"空房有:"<<a<<"間"<<endl;
	cout<<"有病人的有:"<<b<<"間"<<'\n';
	cout<<"清潔中的有:"<<sum<<"間"<<endl;
	return 0; 
	
		
		              
					  
	
}
